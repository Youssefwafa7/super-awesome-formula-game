{
    "start-scene": "menu",
    "window":
    {
        "title":"Super Awesome Formula Game",
        "size":{
            "width":1280,
            "height":720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer":{
            "sky": "assets/textures/sky.jpg",
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "assets":{
            "shaders":{
                "tinted":{
                    "vs":"assets/shaders/tinted.vert",
                    "fs":"assets/shaders/tinted.frag"
                },
                "textured":{
                    "vs":"assets/shaders/textured.vert",
                    "fs":"assets/shaders/textured.frag"
                }
            },
            "meshes":{
                "cube": "assets/models/cube.obj"
            },
            "samplers":{
                "default":{},
                "pixelated":{
                    "MAG_FILTER": "GL_NEAREST"
                }
            },
            "materials":{
                "player_cube":{
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [0.9, 0.1, 0.1, 1.0]
                }
            }
        },
        "world":[
            {
                "name": "main_camera",
                "position": [0, 0, 10],
                "components": [
                    {
                        "type": "Camera"
                    },
                    {
                        "type": "Chase Camera",
                        "target": "player",
                        "offset": [0.0, 1.6, -3.5],
                        "lockRotation": true,
                        "pitch": -0.25,
                        "lookAtOffset": [0.0, 0.7, 0.6]
                    }
                ]        
            },
            {
                "name": "player",
                "position": [0.0, 1.0, 0.0],
                "rotation": [0, 0, 0],
                "scale": [0.4, 0.2, 0.8],
                "components": [
                    {
                        "type": "Car Controller",
                        "acceleration": 14.0,
                        "brakeAcceleration": 20.0,
                        "maxSpeed": 20.0,
                        "maxReverseSpeed": 7.0,
                        "turnSpeed": 2.2,
                        "linearDamping": 4.0,
                        "groundClearance": 0.12
                    },
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "player_cube"
                    }
                ]
            },
            {
                "name": "starting_line",
                "position": [0.0, 0.02, 0.0],
                "rotation": [0, 0, 0],
                "scale": [0.02, 0.02, 0.02],
                "components": [
                    {
                        "type": "Multi Mesh Renderer",
                        "obj": "assets/models/starting_line/starting_line.obj",
                        "shader": "textured",
                        "sampler": "default",
                        "pipelineState": {
                            "faceCulling":{
                                "enabled": false
                            },
                            "depthTesting":{
                                "enabled": true
                            }
                        },
                        "tint": [1, 1, 1, 1]
                    }
                ]
            },
            {
                "name": "track",
                "position": [-18.04, 0.0, -26.12],
                "rotation": [0, 0, 0],
                "scale": [50.0, 50.0, 50.0],
                "components": [
                    {
                        "type": "Track Heightfield",
                        "obj": "assets/models/race_trackkarting_track_based_on_south_garda/race_trackkarting_track_based_on_south_garda.obj",
                        "cellSize": 0.5,
                        "minNormalY": 0.6
                    },
                    {
                        "type": "Multi Mesh Renderer",
                        "obj": "assets/models/race_trackkarting_track_based_on_south_garda/race_trackkarting_track_based_on_south_garda.obj",
                        "shader": "textured",
                        "sampler": "default",
                        "pipelineState": {
                            "faceCulling":{
                                "enabled": false
                            },
                            "depthTesting":{
                                "enabled": true
                            }
                        }
                    }
                ]
            }        
        ]
    }
}