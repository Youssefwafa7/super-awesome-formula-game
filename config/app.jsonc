{
    "start-scene": "menu",
    "window":
    {
        "title":"Super Awesome Formula Game",
        "size":{
            "width":1280,
            "height":720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer":{
            "sky": "assets/textures/sky.jpg",
            "sun": "assets/textures/sun.png",
            "sunDirection": [-2.0, -0.75, -0.45],
            "sunDistance": 500.0,
            "sunScale": 35.0,
            "sunTint": 3.0,
            "sunLightEnabled": true,
            "sunLightColor": [1.0, 0.97, 0.9],
            "sunLightIntensity": 1.6,
            // "postprocess": "assets/shaders/postprocess/vignette.frag",
            "ambient": {
                "color": [0.05, 0.06, 0.08],
                "intensity": 1.0
            }
        },
        "assets":{
            "shaders":{
                "tinted":{
                    "vs":"assets/shaders/tinted.vert",
                    "fs":"assets/shaders/tinted.frag"
                },
                "textured":{
                    "vs":"assets/shaders/textured.vert",
                    "fs":"assets/shaders/textured.frag"
                },
                "lit":{
                    "vs":"assets/shaders/lit.vert",
                    "fs":"assets/shaders/lit.frag"
                }
            },
            "meshes":{
                "standard_kart": "assets/models/standard_kart/standard_kart.obj"            },
            "samplers":{
                "default":{},
                "pixelated":{
                    "MAG_FILTER": "GL_NEAREST"
                }
            },
            "materials":{}
        },
        "world":[
            {
                "name": "moon_light",
                "rotation": [-35, 35, 0],
                "components": [
                    {
                        "type": "Light",
                        "lightType": "directional",
                        "color": [0.55, 0.65, 1.0],
                        "intensity": 1.2
                    }
                ]
            },
            {
                "name": "sun_light",
                "rotation": [-55, -35, 0],
                "components": [
                    {
                        "type": "Light",
                        "lightType": "directional",
                        "color": [1.0, 0.95, 0.85],
                        "intensity": 0.0
                    }
                ]
            },
            {
                "name": "streetlamp_0",
                "position": [10.0, 4.5, 3.5],
                "components": [
                    {
                        "type": "Light",
                        "lightType": "point",
                        "color": [1.0, 0.9, 0.75],
                        "intensity": 12.0,
                        "attenuation": [1.0, 0.09, 0.032]
                    }
                ]
            },
            {
                "name": "main_camera",
                "position": [0, 0, 10],
                "components": [
                    {
                        "type": "Camera"
                    },
                    {
                        "type": "Chase Camera",
                        "target": "player",
                        "offset": [0.0, 3.0, -3.8],
                        "lockRotation": true,
                        "pitch": -0.25,
                        "lookAtOffset": [0.0, 0.7, 0.6]
                    }
                ]        
            },
            {
                "name": "player",
                "position": [9.0, 1.0, 3.5],
                "rotation": [0, 90, 0],
                "scale": [0.1, 0.1, 0.1],
                "components": [
                    {
                        "type": "Light",
                        "lightType": "spot",
                        "color": [1.0, 1.0, 1.0],
                        "intensity": 20.0,
                        "attenuation": [1.0, 0.07, 0.017],
                        "innerAngle": 12.0,
                        "outerAngle": 22.0,
                        "positionOffset": [0.0, 0.35, -1.1]
                    },
                    {
                        "type": "Car Controller",
                        "acceleration": 14.0,
                        "brakeAcceleration": 20.0,
                        "maxSpeed": 20.0,
                        "maxReverseSpeed": 7.0,
                        "turnSpeed": 2.2,
                        "linearDamping": 4.0,
                        "groundClearance": 0.12
                    },
                    {
                        "type": "Multi Mesh Renderer",
                        "mesh": "standard_kart",
                        "shader": "lit",
                        "sampler": "default",
                        "pipelineState": {
                            "faceCulling":{
                                "enabled": false
                            },
                            "depthTesting":{
                                "enabled": true
                            }
                        },
                        "tint": [1, 1, 1, 1]
                    },
                    {
                        "type": "Wheel Spin",
                        "axis": "auto",
                        "direction": 1.0,
                        "desiredWheelCount": 4,
                        "includeNameSubstrings": ["wheel", "tire", "tyre", "rim"],
                        "excludeNameSubstrings": ["body", "chassis"],
                        "debugPrintParts": true
                    }
                ]
            },
            {
                "name": "starting_line",
                "position": [10.0, 1.8, 3.5],
                "rotation": [0, 90, 0],
                "scale": [0.02, 0.02, 0.02],
                "components": [
                    {
                        "type": "Multi Mesh Renderer",
                        "obj": "assets/models/starting_line/starting_line.obj",
                        "shader": "lit",
                        "sampler": "default",
                        "pipelineState": {
                            "faceCulling":{
                                "enabled": false
                            },
                            "depthTesting":{
                                "enabled": true
                            }
                        },
                        "tint": [1, 1, 1, 1]
                    }
                ]
            },
            {
                "name": "track",
                "position": [-18.04, 0.0, -26.12],
                "rotation": [0, 0, 0],
                "scale": [50.0, 50.0, 50.0],
                "components": [
                    {
                        "type": "Track Heightfield",
                        "obj": "assets/models/race_trackkarting_track_based_on_south_garda/race_trackkarting_track_based_on_south_garda.obj",
                        "cellSize": 0.5,
                        "minNormalY": 0.6
                    },
                    {
                        "type": "Multi Mesh Renderer",
                        "obj": "assets/models/race_trackkarting_track_based_on_south_garda/race_trackkarting_track_based_on_south_garda.obj",
                        "shader": "lit",
                        "sampler": "default",
                        "debugPrintParts": true,
                        "pipelineState": {
                            "faceCulling":{
                                "enabled": false
                            },
                            "depthTesting":{
                                "enabled": true
                            }
                        }
                    }
                ]
            }        
        ]
    }
}