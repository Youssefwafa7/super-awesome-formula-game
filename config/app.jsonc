{
    "start-scene": "menu",
    "window":
    {
        "title":"Super Awesome Formula Game",
        "size":{
            "width":1280,
            "height":720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer":{
            "sky": "assets/textures/sky.jpg",
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "assets":{
            "shaders":{
                "tinted":{
                    "vs":"assets/shaders/tinted.vert",
                    "fs":"assets/shaders/tinted.frag"
                },
                "textured":{
                    "vs":"assets/shaders/textured.vert",
                    "fs":"assets/shaders/textured.frag"
                }
            },
            "meshes":{
                "standard_kart": "assets/models/standard_kart/standard_kart.obj"            },
            "samplers":{
                "default":{},
                "pixelated":{
                    "MAG_FILTER": "GL_NEAREST"
                }
            },
            "materials":{}
        },
        "world":[
            {
                "name": "main_camera",
                "position": [0, 0, 10],
                "components": [
                    {
                        "type": "Camera"
                    },
                    {
                        "type": "Chase Camera",
                        "target": "player",
                        "offset": [0.0, 3.0, -3.8],
                        "lockRotation": true,
                        "pitch": -0.25,
                        "lookAtOffset": [0.0, 0.7, 0.6]
                    }
                ]        
            },
            {
                "name": "player",
                "position": [9.0, 1.0, 3.5],
                "rotation": [0, 90, 0],
                "scale": [0.1, 0.1, 0.1],
                "components": [
                    {
                        "type": "Car Controller",
                        "acceleration": 14.0,
                        "brakeAcceleration": 20.0,
                        "maxSpeed": 20.0,
                        "maxReverseSpeed": 7.0,
                        "turnSpeed": 2.2,
                        "linearDamping": 4.0,
                        "groundClearance": 0.12
                    },
                    {
                        "type": "Multi Mesh Renderer",
                        "mesh": "standard_kart",
                        "shader": "textured",
                        "sampler": "default",
                        "pipelineState": {
                            "faceCulling":{
                                "enabled": false
                            },
                            "depthTesting":{
                                "enabled": true
                            }
                        },
                        "tint": [1, 1, 1, 1]
                    },
                    {
                        "type": "Wheel Spin",
                        "axis": "auto",
                        "direction": 1.0,
                        "desiredWheelCount": 4,
                        "includeNameSubstrings": ["wheel", "tire", "tyre", "rim"],
                        "excludeNameSubstrings": ["body", "chassis"],
                        "debugPrintParts": true
                    }
                ]
            },
            {
                "name": "starting_line",
                "position": [10.0, 1.8, 3.5],
                "rotation": [0, 90, 0],
                "scale": [0.02, 0.02, 0.02],
                "components": [
                    {
                        "type": "Multi Mesh Renderer",
                        "obj": "assets/models/starting_line/starting_line.obj",
                        "shader": "textured",
                        "sampler": "default",
                        "pipelineState": {
                            "faceCulling":{
                                "enabled": false
                            },
                            "depthTesting":{
                                "enabled": true
                            }
                        },
                        "tint": [1, 1, 1, 1]
                    }
                ]
            },
            {
                "name": "track",
                "position": [-18.04, 0.0, -26.12],
                "rotation": [0, 0, 0],
                "scale": [50.0, 50.0, 50.0],
                "components": [
                    {
                        "type": "Track Heightfield",
                        "obj": "assets/models/race_trackkarting_track_based_on_south_garda/race_trackkarting_track_based_on_south_garda.obj",
                        "cellSize": 0.5,
                        "minNormalY": 0.6
                    },
                    {
                        "type": "Multi Mesh Renderer",
                        "obj": "assets/models/race_trackkarting_track_based_on_south_garda/race_trackkarting_track_based_on_south_garda.obj",
                        "shader": "textured",
                        "sampler": "default",
                        "debugPrintParts": true,
                        "pipelineState": {
                            "faceCulling":{
                                "enabled": false
                            },
                            "depthTesting":{
                                "enabled": true
                            }
                        }
                    }
                ]
            }        
        ]
    }
}