{
  "start-scene": "menu",
  "window": {
    "title": "Super Awesome Formula Game",
    "size": {
      "width": 1920,
      "height": 1080
    },
    "fullscreen": true
  },
  "scene": {
    "renderer": {
      "sky": "assets/models/kloppenheim_03_puresky_4k.hdr",
      "sun": "assets/textures/sun.png",
      "sunDirection": [-2.0, -0.75, -0.45],
      "sunDistance": 500.0,
      "sunScale": 35.0,
      "sunTint": 3.0,
      "sunLightEnabled": true,
      "sunLightColor": [1.0, 0.97, 0.9],
      "sunLightIntensity": 1.6,
      // "postprocess": "assets/shaders/postprocess/vignette.frag",
      "ambient": {
        "color": [0.05, 0.06, 0.08],
        "intensity": 1.0
      },
      "fog": {
        "enabled": true,
        "color": [0.5, 0.55, 0.6],
        "start": 120.0,
        "end": 450.0,
        "renderDistance": 500.0
      }
    },
    "assets": {
      "shaders": {
        "tinted": {
          "vs": "assets/shaders/tinted.vert",
          "fs": "assets/shaders/tinted.frag"
        },
        "textured": {
          "vs": "assets/shaders/textured.vert",
          "fs": "assets/shaders/textured.frag"
        },
        "lit": {
          "vs": "assets/shaders/lit.vert",
          "fs": "assets/shaders/lit.frag"
        }
      },
      "meshes": {
        "ferrari_1975": "assets/models/Cartoon_Formula_1975/Cartoon_Formula_1975.gltf",
        "ferrari_1991": "assets/models/1991_f1_car/1991.gltf"
      },
      "samplers": {
        "default": {
          "MAX_ANISOTROPY": 16.0
        },
        "pixelated": {
          "MAG_FILTER": "GL_NEAREST"
        }
      },
      "materials": {}
    },

    // Default selection (used on launch; the menu lets you change these).
    "selection": {
      "car": "ferrari_1975",
      "track": "montreal"
    },

    // Presets for cars and tracks.
    // Each preset carries the correct scaling/rotation/positioning so you can switch in-game without mis-sized assets.
    "presets": {
      "cars": [
        // Car preset: Ferrari 1975
        // OBJ size is ~14.6 units long, so we scale it down to ~1.5 world units.
        {
          "id": "ferrari_1975",
          "label": "Ferrari 1975",
          "entity": {
            "name": "player",
            "position": [0.0, 0.0, 0.0],
            "rotation": [0, 0, 0],
            "scale": [0.96, 0.96, 0.96],
            "components": [
              {
                "type": "Light",
                "lightType": "spot",
                "color": [1.0, 1.0, 1.0],
                "intensity": 30.0,
                "attenuation": [1.0, 0.03, 0.002],
                "innerAngle": 12.0,
                "outerAngle": 22.0,
                "positionOffset": [0.0, 0.35, 8.0],
                "invertDirection": true
              },
              {
                "type": "Car Controller",
                "acceleration": 12.0,
                "brakeAcceleration": 28.0,
                "maxSpeed": 53.0,
                "maxReverseSpeed": 17.0,
                "turnSpeed": 2.65,
                "linearDamping": 4.0,
                "grassSpeedFactor": 0.7,
                "grassDamping": 3.8,
                "grassTurnFactor": 0.60,
                "grassAccelFactor": 0.60,
                "wallBounceDamping": 0.32,
                "collisionSubstepDistance": 0.12,
                "collisionRadius": 0.13,
                "wallPushback": 0.004,
                "wallResolveIterations": 4,
                "maxClimbHeight": 0.22,
                "wheelSteerMaxAngle": 50.0,
                "groundClearance": 0.02
              },
              {
                "type": "Multi Mesh Renderer",
                "mesh": "ferrari_1975",
                "shader": "lit",
                "sampler": "default",
                "pipelineState": {
                  "faceCulling": { "enabled": true },
                  "depthTesting": { "enabled": true }
                },
                "tint": [1, 1, 1, 1]
              },
              {
                "type": "Wheel Spin",
                "axis": "auto",
                "direction": 1.0,
                "desiredWheelCount": 4,
                "includeNameSubstrings": ["wheel", "tire", "tyre", "rim"],
                "excludeNameSubstrings": ["body", "chassis"],
                "debugPrintParts": true
              }
            ]
          }
        },

        // Car preset: Ferrari 1991
        // This OBJ is extremely tiny in its authoring units, so it needs a large scale.
        {
          "id": "ferrari_1991",
          "label": "Ferrari 1991",
          "entity": {
            "name": "player",
            "position": [0.0, 0.0, 0.0],
            "rotation": [0, 0, 0],
            "scale": [0.25, 0.25, 0.25],
            "components": [
              {
                "type": "Light",
                "lightType": "spot",
                "color": [1.0, 1.0, 1.0],
                "intensity": 20.0,
                "attenuation": [1.0, 0.03, 0.002],
                "innerAngle": 12.0,
                "outerAngle": 22.0,
                "positionOffset": [0.0, 0.0001, 0.003],
                "invertDirection": true
              },
              {
                "type": "Car Controller",
                "acceleration": 12.0,
                "brakeAcceleration": 28.0,
                "maxSpeed": 53.0,
                "maxReverseSpeed": 17.0,
                "turnSpeed": 2.65,
                "linearDamping": 4.0,
                "grassSpeedFactor": 0.7,
                "grassDamping": 3.8,
                "grassTurnFactor": 0.60,
                "grassAccelFactor": 0.60,
                "wallBounceDamping": 0.32,
                "collisionSubstepDistance": 0.12,
                "collisionRadius": 0.13,
                "wallPushback": 0.004,
                "wallResolveIterations": 4,
                "maxClimbHeight": 0.22,
                "wheelSteerMaxAngle": 50.0,
                "groundClearance": 0.02
              },
              {
                "type": "Multi Mesh Renderer",
                "mesh": "ferrari_1991",
                "recenterToOrigin": false,
                "shader": "lit",
                "sampler": "default",
                "pipelineState": {
                  "faceCulling": { "enabled": true },
                  "depthTesting": { "enabled": true }
                },
                "tint": [1, 1, 1, 1]
              },
              {
                "type": "Wheel Spin",
                "axis": "auto",
                "direction": 1.0,
                "desiredWheelCount": 0,
                "includeNameSubstrings": ["wheel", "tire", "tyre", "rim"],
                "excludeNameSubstrings": ["body", "chassis"],
                "debugPrintParts": false
              }
            ]
          }
        }
      ],

      "tracks": [
        // Track preset: Montreal
        {
          "id": "montreal",
          "label": "Montreal",
          "spawn": {
            "position": [146.21, 1.0, 44.44],
            "rotation": [0, -270, 0]
          },
          "entity": {
            "name": "track",
            "position": [-18.04, 0.0, -26.12],
            "rotation": [0, 0, 0],
            "scale": [1.6, 1.6, 1.6],
            "components": [
              {
                "type": "Track Heightfield",
                "model": "assets/models/Cartoon_Race_Track_Montreal/Cartoon_Race_Track_Montreal.gltf",
                "cellSize": 0.2,
                "minNormalY": 0.8,
                "hardWallNormalY": 0.0,
                "treatUnknownAsGrass": true,
                "grassSearchCells": 2,
                "buildWallSegments": true,
                "wallCollisionDilateCells": 0,
                "wallCollisionMargin": 0.0,
                "roadTextureHints": [
                  "road",
                  "asphalt",
                  "track",
                  "line",
                  "concrete"
                ],
                "grassTextureHints": [
                  "grass",
                  "terrain",
                  "ground",
                  "turf",
                  "soil",
                  "dirt"
                ],
                "wallTextureHints": [
                  "wall",
                  "barrier",
                  "fence",
                  "guardrail",
                  "rail",
                  "tire",
                  "tyre",
                  "collider"
                ],
                "curbTextureHints": ["curb", "kerb"]
              },
              {
                "type": "Multi Mesh Renderer",
                "mergeByMaterial": true,
                "model": "assets/models/Cartoon_Race_Track_Montreal/Cartoon_Race_Track_Montreal.gltf",
                "shader": "lit",
                "sampler": "default",
                "debugPrintParts": false,
                "excludeMaterials": ["collider"],
                "pipelineState": {
                  "faceCulling": { "enabled": true },
                  "depthTesting": { "enabled": true }
                }
              }
            ]
          }
        },
        // Track preset: Silverstone
        {
          "id": "silverstone",
          "label": "Silverstone",
          "spawn": {
            // Spawn on the start/finish area (world coordinates).
            "position": [-500.89, 0.85, -129.9],
            "rotation": [0, -187.5, 0]
          },
          "entity": {
            "name": "track",
            "position": [0.0, 0.0, 0.0],
            "rotation": [0, 0, 0],
            "scale": [1.4, 1.4, 1.4],
            "components": [
              {
                "type": "Track Heightfield",
                "model": "assets/models/silverstone-gltf-test/silverstone_light.gltf",
                "cellSize": 0.2,
                "minNormalY": 0.6,
                "hardWallNormalY": 0.0,
                "treatUnknownAsGrass": true,
                "grassSearchCells": 2,
                "buildWallSegments": true,
                "wallCollisionDilateCells": 0,
                "wallCollisionMargin": 0.0,
                "roadTextureHints": [
                  "road",
                  "asphalt",
                  "track",
                  "line",
                  "concrete"
                ],
                "grassTextureHints": [
                  "grass",
                  "terrain",
                  "ground",
                  "turf",
                  "soil",
                  "dirt"
                ],
                "wallTextureHints": [
                  "wall",
                  "barrier",
                  "fence",
                  "guardrail",
                  "rail",
                  "tire",
                  "tyre",
                  "collider"
                ],
                "curbTextureHints": ["curb", "kerb"]
              },
              {
                "type": "Multi Mesh Renderer",
                "mergeByMaterial": true,
                "model": "assets/models/silverstone-gltf-test/silverstone_light.gltf",
                "shader": "lit",
                "sampler": "default",
                "debugPrintParts": false,
                "excludeMaterials": ["collider"],
                "pipelineState": {
                  "faceCulling": { "enabled": true },
                  "depthTesting": { "enabled": true }
                }
              }
            ]
          }
        },
        // Track preset: Spa
        // Copying defaults from South Garda; adjust spawn/position as needed.
        {
          "id": "spa",
          "label": "Spa",
          "spawn": {
            "position": [-25.3, -0.52, -4.61],
            "rotation": [0, -269, 0]
          },
          "entity": {
            "name": "track",
            "position": [0, 0, 0],
            "rotation": [0, 0, 0],
            "scale": [1, 1, 1],
            "components": [
              {
                "type": "Track Heightfield",
                "model": "assets/models/Cartoon_Race_Track_Spa/Cartoon_Race_Track_Spa.gltf",
                "cellSize": 0.6,
                "minNormalY": 0.8,
                "hardWallNormalY": 0.0,
                "treatUnknownAsGrass": true,
                "grassSearchCells": 4,
                "buildWallSegments": true,
                "wallCollisionDilateCells": 0,
                "wallCollisionMargin": 1.0,
                "roadTextureHints": [
                  "road",
                  "asphalt",
                  "track",
                  "line",
                  "concrete"
                ],
                "grassTextureHints": [
                  "grass",
                  "terrain",
                  "ground",
                  "turf",
                  "soil",
                  "dirt"
                ],
                "wallTextureHints": [
                  "wall",
                  "barrier",
                  "fence",
                  "guardrail",
                  "rail",
                  "tire",
                  "tyre",
                  "collider"
                ],
                "curbTextureHints": ["curb", "kerb"]
              },
              {
                "type": "Multi Mesh Renderer",
                "mergeByMaterial": true,
                "model": "assets/models/Cartoon_Race_Track_Spa/Cartoon_Race_Track_Spa.gltf",
                "shader": "lit",
                "sampler": "default",
                "debugPrintParts": false,
                "excludeMaterials": ["collider"],
                "pipelineState": {
                  "faceCulling": { "enabled": true },
                  "depthTesting": { "enabled": true }
                }
              }
            ]
          }
        }
      ]
    },

    "world": [
      {
        "name": "moon_light",
        "rotation": [-35, 35, 0],
        "components": [
          {
            "type": "Light",
            "lightType": "directional",
            "color": [0.55, 0.65, 1.0],
            "intensity": 1.2
          }
        ]
      },
      {
        "name": "sun_light",
        "rotation": [-55, -35, 0],
        "components": [
          {
            "type": "Light",
            "lightType": "directional",
            "color": [1.0, 0.95, 0.85],
            "intensity": 0.0
          }
        ]
      },
      {
        "name": "streetlamp_0",
        "position": [10.0, 4.5, 3.5],
        "components": [
          {
            "type": "Light",
            "lightType": "point",
            "color": [1.0, 0.9, 0.75],
            "intensity": 12.0,
            "attenuation": [1.0, 0.09, 0.032]
          }
        ]
      },
      {
        "name": "main_camera",
        "position": [0, 0, 10],
        "components": [
          {
            "type": "Camera",
            "far": 1000.0
          },
          {
            "type": "Chase Camera",
            "target": "player",
            "offset": [0.0, 2.5, -4.4],
            "lockRotation": true,
            "pitch": -0.25,
            "lookAtOffset": [0.0, 0.7, 0.6]
          }
        ]
      }
    ]
  }
}
